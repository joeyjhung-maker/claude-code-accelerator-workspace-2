# Genesis Bots credentials. Keep this file private — never commit or share it.
# Easiest: replace this ENTIRE file with what the portal's "Copy .env" button
# gives you (https://genesis.copycoders.ai/portal), then add your provider key.

GENESIS_BASE_URL=https://gas.copycoders.ai/api/v1
GENESIS_API_KEY=gen_your_key_here

# Your provider key (you pay usage). Use ONE of these — match the name to your key:
#   Anthropic  → ANTHROPIC_API_KEY=sk-ant-...
#   OpenRouter → OPENROUTER_API_KEY=sk-or-...
# (`npx exodus keys pull` writes these names for you from the dashboard.)
ANTHROPIC_API_KEY=sk-ant-your_provider_key_here
